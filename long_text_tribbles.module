<?php
/**
 * @file
 *  Provides functions to prevents unwanted empty long-text field items from being
 *  saved to the database. 
 */

/**
 * Implements hook_entity_presave().
 */
function long_text_tribbles_entity_presave($entity, $entity_type) {
  $instances = field_info_instances($entity_type, $entity->bundle());
  foreach ($instances as $field_name => $instance) {
    $field_info = field_info_field($field_name);
    if (!empty($entity->$field_name[LANGUAGE_NONE]) && in_array($field_info['type'], array('text_with_summary', 'text_long')) && $field_info['cardinality'] == -1 && $instance['settings']['text_processing'] == 1) {
      foreach ($entity->$field_name[LANGUAGE_NONE] as $delta => $item) {
        if (empty($item['value'])) {
          unset($entity->$field_name[LANGUAGE_NONE][$delta]);
        }
      }
    }
  }
}
